---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import photo from '../assets/aamir.jpg';
import Social from '../components/Social.astro';
---
<Base>
<div class="hero">
<Image src={photo} alt="Portrait of Aamir Khan" widths={[240,480]} sizes="240px" class="portrait" loading="eager" />
<div>
<h1>Hi, I'm Aamir.</h1>
<p class="lead">Technical Project Manager at <a href="https://featherflow.com">FeatherFlow</a>. I help companies and ambitious founders around the world turn AI ideas into real products.</p>
<p><a href="/about">More about me →</a></p>
<Social size={22} />
</div>
</div>
</Base>
