---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import photo from '../assets/aamir.jpg';
---
<Base>
<div class="hero">
<Image src={photo} alt="Portrait of Aamir Khan" widths={[240,480]} sizes="240px" class="portrait" loading="eager" />
<div>
<h1>Hi, I'm Aamir.</h1>
<p class="lead">Technical Project Manager at <a href="https://featherflow.com">FeatherFlow</a>, where I help companies around the world turn AI ideas into real products. I grew up between cultures, speak five languages, and like making complex things simple.</p>
<p><a href="/about">More about me →</a></p>
</div>
</div>
</Base>
