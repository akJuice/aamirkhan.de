---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import photo from '../assets/aamir.jpg';
import aboutPhoto from '../assets/aamir-about.jpg';
import FeatherFlow from '../components/FeatherFlow.astro';
import DotArrow from '../components/DotArrow.astro';
import Globe from '../components/Globe.astro';
import DotModel from '../components/DotModel.astro';
import ExternalArrow from '../components/ExternalArrow.astro';
const posts = (await getCollection('blog', p => !p.data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,3);
const label = { professional: 'Professional', personal: 'Personal' } as const;
const fmt = (d: Date) => d.toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'});
---
<Base>
<section class="hero split">
<div class="split-text">
<h1 class="greet">
<span class="sr-only">Hi, I'm Aamir.</span>
<span class="greet-text" id="greet" aria-hidden="true">Hi, I'm <span class="name-blue">Aamir</span>.</span>
</h1>
<p class="lead"><a class="arrow-link" href="/blog/what-is-a-third-culture-kid/">Third Culture Kid<DotArrow /></a></p>
<p class="lead"><strong>Turning ideas into products</strong> <span class="nowrap dim">at <FeatherFlow /></span></p>
</div>
<div class="split-media hero-media">
<Image src={photo} alt="Portrait of Aamir Khan" widths={[400,800]} sizes="(max-width: 860px) 320px, 400px" class="photo" loading="eager" />
</div>
<a class="scroll-hint" href="#about" aria-label="Scroll to About me"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v15M6 13l6 6 6-6"/></svg></a>
</section>

<section id="about" class="about-head split reveal">
<div class="split-text"><p class="eyebrow">01 · About</p><h2 class="section-title">About me</h2></div>
<div class="split-media"><Image src={aboutPhoto} alt="Aamir Khan sitting in a boat on a lake with mountains behind him" widths={[420,840]} sizes="(max-width: 860px) 320px, 50vw" class="photo" /></div>
</section>

<div class="story">
<section class="split reveal flip">
<div class="split-text">
<p class="eyebrow">02 · Journey</p>
<h2>My Journey</h2>
<p><strong>Born in Bangalore, raised in Turkey, at home in Germany.</strong> I have been living here since 2016.</p>
<p><strong>Moving between three countries made me a third culture kid.</strong> It shaped how I see the world, and along the way I picked up English, German, Turkish, Hindi and Urdu, plus a little Italian.</p>
<p><a class="arrow-link" href="/blog/what-is-a-third-culture-kid/">What it means to be a third culture kid<DotArrow /></a></p>
</div>
<div class="split-media"><Globe /></div>
</section>

<section class="split reveal">
<div class="split-text">
<p class="eyebrow">03 · Education</p>
<h2>Education</h2>
<p><strong>Maths was always my thing.</strong> I started high school in Turkey and completed it in Cologne. After that, I completed my bachelor's degree in computer science at RWTH Aachen University.</p>
</div>
<div class="split-media"><DotModel model="cap" label="Rotating 3D graduation cap" /></div>
</section>

<section class="split reveal flip">
<div class="split-text">
<p class="eyebrow">04 · Work</p>
<h2>Work</h2>
<p><strong>Today I am a Technical Project Manager</strong> <span class="nowrap">at <FeatherFlow />,</span> a product agency that helps companies and ambitious founders around the world turn AI ideas into real products. I work at the intersection of clients and engineering: scoping products, keeping delivery on track, and making sure what we build solves the actual problem.</p>
<p>I also spent a year at Bosch as an intern in Sales, Strategy and Business Excellence, and wrote my bachelor's thesis with Bosch.</p>
<p><a class="arrow-link" href="/blog/?c=professional">Read what I write about AI and products<DotArrow /></a></p>
</div>
<div class="split-media"><DotModel model="laptop" label="Rotating 3D laptop" /></div>
</section>

<section class="split reveal">
<div class="split-text">
<p class="eyebrow">05 · Life</p>
<h2>Outside of work</h2>
<p><strong>You will usually find me on a basketball court or in the gym.</strong> I also love going to events about personal development. Meeting people who want to grow is one of the best ways I know to keep learning.</p>
</div>
<div class="split-media"><DotModel model="sports" label="Rotating 3D basketball and dumbbell" /></div>
</section>
</div>

<section class="latest reveal">
<div class="latest-head"><div><p class="eyebrow">06 · Writing</p><h2 class="section-title">Latest writing</h2></div><a class="arrow-link quiet" href="/blog">All posts<DotArrow /></a></div>
<ul class="posts">
{posts.map(p => (
  <li>
    <span><a class="title" href={p.data.externalUrl ?? `/blog/${p.id}/`} {...(p.data.externalUrl ? { target: '_blank', rel: 'noopener' } : {})}>{p.data.title}{p.data.externalUrl && <ExternalArrow />}</a>{p.data.publisher && <span class="muted"> · on {p.data.publisher}</span>}</span>
    <span class="meta"><span class="tag">{label[p.data.category]}</span><time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time></span>
  </li>
))}
</ul>
</section>
</Base>

<script>
  // Photo spans exactly from the 'Home' link to the theme toggle
  const fitPhoto = () => {
    const nav = document.querySelector('header.site nav');
    if (!nav) return;
    const r = nav.getBoundingClientRect();
    document.documentElement.style.setProperty('--nav-w', Math.round(r.width) + 'px');
  };
  fitPhoto(); addEventListener('resize', fitPhoto); document.fonts?.ready.then(fitPhoto);

  const greetings: [string, string][] = [
    ["Hi, I'm Aamir.", 'Aamir'],
    ['Hallo, ich bin Aamir.', 'Aamir'],
    ['Merhaba, ben Aamir.', 'Aamir'],
    ['नमस्ते, मैं आमिर हूँ।', 'आमिर'],
  ];
  const el = document.getElementById('greet')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let i = 0;
  if (!reduce) {
    setInterval(() => {
      el.classList.add('out');
      setTimeout(() => {
        i = (i + 1) % greetings.length;
        const [text, name] = greetings[i];
        el.textContent = '';
        const [before, after] = text.split(name);
        const span = document.createElement('span');
        span.className = 'name-blue'; span.textContent = name;
        el.append(before, span, after);
        el.classList.remove('out');
      }, 350);
    }, 2200);
  }
</script>
