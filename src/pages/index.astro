---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import photo from '../assets/aamir.jpg';
import FeatherFlow from '../components/FeatherFlow.astro';
import DotArrow from '../components/DotArrow.astro';
---
<Base>
<section class="hero split">
<div class="split-text">
<h1 class="greet">
<span class="sr-only">Hi, I'm Aamir.</span>
<span class="greet-text" id="greet" aria-hidden="true">Hi, I'm Aamir.</span>
</h1>
<p class="lead"><a class="arrow-link quiet" href="/blog/what-is-a-third-culture-kid/">Third Culture Kid<DotArrow /></a></p>
<p class="lead">Turning ideas into products at <FeatherFlow /></p>
</div>
<div class="split-media">
<Image src={photo} alt="Portrait of Aamir Khan" widths={[400,800]} sizes="(max-width: 860px) 320px, 400px" class="photo" loading="eager" />
</div>
</section>
</Base>

<script>
  const greetings: [string, string?][] = [
    ["Hi, I'm Aamir."],
    ['Hallo, ich bin Aamir.'],
    ['Merhaba, ben Aamir.'],
    ['नमस्ते, मैं आमिर हूँ।'],
  ];
  const el = document.getElementById('greet')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let i = 0;
  if (!reduce) {
    setInterval(() => {
      el.classList.add('out');
      setTimeout(() => {
        i = (i + 1) % greetings.length;
        const [text, dir] = greetings[i];
        el.textContent = text;
        el.dir = dir ?? 'ltr';
        el.classList.remove('out');
      }, 350);
    }, 2200);
  }
</script>
