---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const posts = await getCollection('blog', p => !p.data.draft && !p.data.externalUrl);
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description}>
<article>
<h1>{post.data.title}</h1>
<p class="muted"><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric'})}</time></p>
<Content />
</article>
<p><a href="/blog">← All posts</a></p>
</Base>
