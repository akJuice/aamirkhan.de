---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import avatar from '../../assets/avatar.jpg';
import DotArrow from '../../components/DotArrow.astro';
export async function getStaticPaths() {
  const posts = await getCollection('blog', p => !p.data.draft && !p.data.externalUrl);
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description}>
<article class="post">
<h1>{post.data.title}</h1>
<div class="byline"><Image src={avatar} alt="" width={112} height={112} class="avatar" /><div class="who"><strong>Aamir Khan</strong><span class="muted">Updated <time datetime={(post.data.updated ?? post.data.date).toISOString()}>{(post.data.updated ?? post.data.date).toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric'})}</time></span></div></div>
<div class="prose"><Content /></div>
</article>
<p class="post-back"><a class="arrow-link quiet" href="/blog"><DotArrow dir="left" />All posts</a></p>
</Base>
