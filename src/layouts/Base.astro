---
import '../styles/global.css';
import Social from '../components/Social.astro';
interface Props { title?: string; description?: string }
const { title, description = 'Aamir Khan — Technical Project Manager helping companies and ambitious founders turn AI ideas into real products.' } = Astro.props;
const full = title ? `${title} · Aamir Khan` : 'Aamir Khan';
const path = Astro.url.pathname;
const links = [['/about','About'],['/blog','Blog'],['/contact','Contact']];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{full}</title><meta name="description" content={description} />
<link rel="canonical" href={new URL(path, Astro.site)} />
<meta property="og:title" content={full} /><meta property="og:description" content={description} />
<link rel="alternate" type="application/rss+xml" title="Aamir Khan" href="/rss.xml" />
<link rel="icon" href="/favicon.svg" />
<script is:inline>try{const t=localStorage.getItem('theme');if(t)document.documentElement.dataset.theme=t}catch(e){}</script>
</head>
<body>
<div class="wrap">
<header class="site">
<a class="name" href="/">Aamir Khan</a>
<nav>
{links.map(([h,l]) => <a href={h} aria-current={path.startsWith(h) ? 'page' : undefined}>{l}</a>)}
<button class="theme" id="theme" aria-label="Toggle dark mode">◐</button>
</nav>
</header>
<main><slot /></main>
<footer>
<span>© {new Date().getFullYear()} Aamir Khan</span>
<Social size={18} />
<span><a href="/impressum">Impressum</a> · <a href="/datenschutz">Datenschutz</a></span>
</footer>
</div>
<script is:inline>
document.getElementById('theme').onclick=()=>{const r=document.documentElement;const dark=r.dataset.theme?r.dataset.theme==='dark':matchMedia('(prefers-color-scheme: dark)').matches;r.dataset.theme=dark?'light':'dark';try{localStorage.setItem('theme',r.dataset.theme)}catch(e){}};
</script>
</body>
</html>
