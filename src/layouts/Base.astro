---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/geist/index.css';
import '../styles/global.css';
import Social from '../components/Social.astro';
interface Props { title?: string; description?: string }
const { title, description = 'Aamir Khan, a third culture kid helping companies and ambitious founders around the world turn AI ideas into real products.' } = Astro.props;
const full = title ? `${title} · Aamir Khan` : 'Aamir Khan';
const path = Astro.url.pathname;
const links = [['/','Home'],['/about','About me'],['/blog','Blog'],['/contact','Get in touch']];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{full}</title><meta name="description" content={description} />
<link rel="canonical" href={new URL(path, Astro.site)} />
<meta property="og:type" content="website" /><meta property="og:url" content={new URL(path, Astro.site)} />
<meta property="og:title" content={full} /><meta property="og:description" content={description} />
<meta property="og:image" content={new URL("/og.jpg", Astro.site)} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="Aamir Khan" />
<meta name="twitter:card" content="summary_large_image" /><meta name="twitter:site" content="@AamirBuilds" /><meta name="twitter:image" content={new URL("/og.jpg", Astro.site)} />
<link rel="alternate" type="application/rss+xml" title="Aamir Khan" href="/rss.xml" />
<link rel="icon" href="/favicon.svg" />
<script is:inline>try{const t=localStorage.getItem('theme');if(t)document.documentElement.dataset.theme=t}catch(e){}</script>
<!-- Privacy-friendly analytics by Plausible -->
<script is:inline async src="https://plausible.io/js/pa-kqtvLvo9cdKqBTK9JsOo_.js"></script>
<script is:inline>
  window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
  plausible.init()
</script>
</head>
<body>
<div class="wrap">
<header class="site">
<a class="name" href="/">Aamir Khan</a>
<nav>
{links.map(([h,l]) => <a href={h} aria-current={(h === '/' ? path === '/' : path.startsWith(h)) ? 'page' : undefined}>{l}</a>)}
<button class="theme" id="theme" aria-label="Toggle dark mode">◐</button>
</nav>
</header>
<main><slot /></main>
<footer>
<span>© {new Date().getFullYear()} Aamir Khan</span>
<Social size={18} />
<span><a href="/legal">Legal</a></span>
</footer>
</div>
<script is:inline>
document.getElementById('theme').onclick=()=>{const r=document.documentElement;const dark=r.dataset.theme?r.dataset.theme==='dark':matchMedia('(prefers-color-scheme: dark)').matches;r.dataset.theme=dark?'light':'dark';try{localStorage.setItem('theme',r.dataset.theme)}catch(e){}};
</script>
</body>
</html>
