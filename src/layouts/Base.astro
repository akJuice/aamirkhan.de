---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/geist/index.css';
import '../styles/global.css';
import Social from '../components/Social.astro';
interface Props { title?: string; description?: string }
const { title, description = 'Aamir Khan, a third culture kid helping companies and ambitious founders around the world turn AI ideas into real products.' } = Astro.props;
const full = title ? `${title} · Aamir Khan` : 'Aamir Khan';
const path = Astro.url.pathname;
const links = [['/','Home'],['/#about','About me'],['/blog','Blog'],['#contact','Get in touch']];
---
<!doctype html>
<html lang="en" data-theme="light">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{full}</title><meta name="description" content={description} />
<link rel="canonical" href={new URL(path, Astro.site)} />
<meta property="og:type" content="website" /><meta property="og:url" content={new URL(path, Astro.site)} />
<meta property="og:title" content={full} /><meta property="og:description" content={description} />
<meta property="og:image" content={new URL("/og.jpg", Astro.site)} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="Aamir Khan" />
<meta name="twitter:card" content="summary_large_image" /><meta name="twitter:site" content="@AamirBuilds" /><meta name="twitter:image" content={new URL("/og.jpg", Astro.site)} />
<link rel="alternate" type="application/rss+xml" title="Aamir Khan" href="/rss.xml" />
<link rel="icon" href="/favicon.svg" />
<!-- Privacy-friendly analytics by Plausible -->
<script is:inline async src="https://plausible.io/js/pa-kqtvLvo9cdKqBTK9JsOo_.js"></script>
<script is:inline>
  window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
  plausible.init()
</script>
</head>
<body>
<div class="wrap">
<header class="site">
<a class="name" href="/">Aamir Khan</a>
<nav>
{links.map(([h,l]) => <a href={h} aria-current={(h === '/' ? path === '/' : path.startsWith(h)) ? 'page' : undefined}>{l}</a>)}
</nav>
</header>
<main><slot /></main>
</div>
<section class="cta" id="contact" aria-label="Get in touch">
<div class="cta-in">
<p class="eyebrow">Get in touch</p>
<h2 class="cta-title">Let's talk.<br /><span class="dim">About AI, life between cultures, or anything you read here.</span></h2>
<p class="cta-mail"><a href="mailto:aamirkhan760109@gmail.com">aamirkhan760109@gmail.com</a></p>
<div class="cta-row"><Social size={22} /></div>
<footer>
<span>© {new Date().getFullYear()} Aamir Khan</span>
<span><a href="/legal">Legal</a></span>
</footer>
</div>
</section>
<script is:inline>
(()=>{const h=document.querySelector('header.site');const set=()=>document.documentElement.style.setProperty('--hdr',h.offsetHeight+'px');set();addEventListener('resize',set);document.fonts&&document.fonts.ready.then(set)})();
// Fade sections in as they scroll into view; highlight Home / About me in the nav on the homepage
(()=>{const els=document.querySelectorAll('.reveal');if(!('IntersectionObserver'in window)){els.forEach(e=>e.classList.add('in'));return}
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{rootMargin:'0px 0px -12% 0px',threshold:.08});els.forEach(e=>io.observe(e));
const about=document.getElementById('about');if(!about)return;const home=document.querySelector('header.site nav a[href="/"]'),ab=document.querySelector('header.site nav a[href="/#about"]');
const spy=()=>{const on=about.getBoundingClientRect().top<innerHeight*.5;ab.toggleAttribute('aria-current',on);if(on)ab.setAttribute('aria-current','page');home.toggleAttribute('aria-current',!on);if(!on)home.setAttribute('aria-current','page')};
addEventListener('scroll',spy,{passive:true});spy();
home.addEventListener('click',e=>{e.preventDefault();scrollTo({top:0,behavior:'smooth'});history.replaceState(null,'','/')});})();
</script>
</body>
</html>
