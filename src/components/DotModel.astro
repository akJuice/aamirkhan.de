---
// One engine for every dotted 3D object on the site (globe, cap, laptop, sports),
// so they all share the same look: grey dot-matrix shapes, blue accents, soft depth fade.
interface Props {
  model: 'globe' | 'cap' | 'laptop' | 'sports' | 'plane' | 'book';
  label: string;
  data?: unknown; // extra data, e.g. land points + places for the globe
}
const { model, label, data } = Astro.props;
---
<div class="dm-wrap">
  <canvas class="dotmodel" data-model={model} data-extra={data ? JSON.stringify(data) : undefined} aria-label={label}></canvas>
</div>

<script>
  // Load the 3D engine only when an object scrolls into view
  const io = new IntersectionObserver((entries) => {
    entries.forEach(async (e) => {
      if (!e.isIntersecting) return;
      const canvas = e.target as HTMLCanvasElement;
      io.unobserve(canvas);
      const { initDotModel } = await import('../scripts/dotmodel');
      initDotModel(canvas);
    });
  }, { rootMargin: '200px' });
  document.querySelectorAll<HTMLCanvasElement>('canvas.dotmodel').forEach((c) => io.observe(c));
</script>

<style>
  .dm-wrap { width: 100%; }
  canvas.dotmodel { width: 100%; max-width: 440px; aspect-ratio: 1; display: block; margin: 0 auto; cursor: grab; touch-action: pan-y; opacity: 0; transition: opacity .8s; }
</style>
