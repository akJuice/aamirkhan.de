---
// One engine for every dotted 3D object on the site (globe, cap, laptop, sports),
// so they all share the same look: grey dot-matrix shapes, blue accents, soft depth fade.
interface Props {
  model: 'globe' | 'cap' | 'laptop' | 'sports' | 'plane';
  label: string;
  data?: unknown; // extra data, e.g. land points + places for the globe
}
const { model, label, data } = Astro.props;
---
<div class="dm-wrap">
  <canvas class="dotmodel" data-model={model} data-extra={data ? JSON.stringify(data) : undefined} aria-label={label}></canvas>
</div>

<script>
  import * as THREE from 'three';

  type Arr = number[];
  type Built = { parts: { obj: THREE.Object3D; spin: number }[]; tilt: number; y: number; startY: number; noFog?: boolean; update?: (t: number) => void };

  const isDark = () => {
    const t = document.documentElement.dataset.theme;
    return t ? t === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
  };
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const S = 0.055; // shared dot spacing

  // ---------- point helpers ----------
  const mats: { m: THREE.PointsMaterial; kind: string; color?: string }[] = [];
  function points(arr: Arr, size: number, kind: string, color?: string) {
    const g = new THREE.BufferGeometry();
    g.setAttribute('position', new THREE.Float32BufferAttribute(arr, 3));
    const m = new THREE.PointsMaterial({ size, sizeAttenuation: true, transparent: true, depthWrite: false });
    mats.push({ m, kind, color });
    return new THREE.Points(g, m);
  }
  function sphere(out: Arr, r: number, n: number, cx = 0, cy = 0, cz = 0) {
    const g = Math.PI * (3 - Math.sqrt(5));
    for (let i = 0; i < n; i++) {
      const y = 1 - (i / (n - 1)) * 2, rr = Math.sqrt(1 - y * y), a = g * i;
      out.push(cx + Math.cos(a) * rr * r, cy + y * r, cz + Math.sin(a) * rr * r);
    }
  }
  function ring(out: Arr, r: number, y: number, step = S, axis: 'y' | 'x' = 'y', cx = 0) {
    const n = Math.max(8, Math.round((2 * Math.PI * r) / step));
    for (let i = 0; i < n; i++) {
      const a = (i / n) * Math.PI * 2;
      if (axis === 'y') out.push(cx + Math.cos(a) * r, y, Math.sin(a) * r);
      else out.push(cx + y, Math.cos(a) * r, Math.sin(a) * r);
    }
  }
  const ll = (lat: number, lng: number, r: number) => {
    const p = (lat * Math.PI) / 180, l = (lng * Math.PI) / 180;
    return new THREE.Vector3(Math.cos(p) * Math.sin(l) * r, Math.sin(p) * r, Math.cos(p) * Math.cos(l) * r);
  };

  // ---------- models ----------
  function buildGlobe(extra: any): Built {
    const R = 1.2, water: Arr = [], land: Arr = [], hi: Arr = [], arcs: Arr = [];
    const N = extra.n as number, mask = extra.mask as string, golden = Math.PI * (3 - Math.sqrt(5));
    for (let i = 0; i < N; i++) {
      const y = 1 - (i / (N - 1)) * 2, rr = Math.sqrt(1 - y * y), a = golden * i;
      const lat = (Math.asin(y) * 180) / Math.PI, lng = ((((a * 180) / Math.PI) % 360) + 540) % 360 - 180;
      const c = mask[i], v = ll(lat, lng, c === '0' ? R * 0.997 : R);
      (c === '0' ? water : c === '1' ? land : hi).push(v.x, v.y, v.z);
      void rr;
    }
    const g = new THREE.Group();
    g.add(points(water, 0.022, 'water'), points(land, 0.026, 'body'), points(hi, 0.032, 'accent'));

    const places = extra.places as { loc: [number, number] }[];
    // marker clusters on each place
    const marks: Arr = [];
    places.forEach((p) => {
      const c = ll(p.loc[0], p.loc[1], R * 1.012); marks.push(c.x, c.y, c.z);
      for (let i = 0; i < 12; i++) { const a = (i / 12) * Math.PI * 2; const w = ll(p.loc[0] + Math.cos(a) * 2.4, p.loc[1] + Math.sin(a) * 3, R * 1.012); marks.push(w.x, w.y, w.z); }
    });
    g.add(points(marks, 0.06, 'accent'));

    // dotted arcs + a path for the travelling light
    const path: THREE.Vector3[] = [];
    for (let k = 1; k < places.length; k++) {
      const a = ll(places[k - 1].loc[0], places[k - 1].loc[1], R), b = ll(places[k].loc[0], places[k].loc[1], R);
      for (let t = 0; t <= 1.0001; t += 0.01) {
        const v = a.clone().lerp(b, t).normalize().multiplyScalar(R * (1 + 0.18 * Math.sin(Math.PI * t)));
        if (Math.round(t * 100) % 2 === 0) arcs.push(v.x, v.y, v.z);
        path.push(v);
      }
      for (let i = 0; i < 60; i++) path.push(path[path.length - 1]); // pause at each stop
    }
    for (let i = 0; i < 80; i++) path.push(path[path.length - 1]); // longer pause at the end
    g.add(points(arcs, 0.024, 'faintAccent'));

    // travelling light: a short comet that runs India -> Turkey -> Germany and repeats
    const TRAIL = 14, trailArr = new Float32Array(TRAIL * 3);
    const comet = points(Array.from(trailArr), 0.055, 'accent');
    g.add(comet);
    const pos = comet.geometry.getAttribute('position') as THREE.BufferAttribute;
    const update = (time: number) => {
      const head = Math.floor((time / 16) % path.length);
      for (let j = 0; j < TRAIL; j++) {
        const v = path[Math.max(0, head - j * 2)];
        pos.setXYZ(j, v.x, v.y, v.z);
      }
      pos.needsUpdate = true;
    };
    return { parts: [{ obj: g, spin: 1 }], tilt: 0.38, y: 0, startY: -(40 * Math.PI) / 180, update };
  }

  function buildCap(): Built {
    const body: Arr = [], tassel: Arr = [];
    const half = 1.15, topY = 0.32, thick = 0.06;
    for (let x = -half; x <= half + 1e-6; x += S)
      for (let z = -half; z <= half + 1e-6; z += S) {
        body.push(x, topY, z);
        if (Math.abs(Math.abs(x) - half) < S / 2 || Math.abs(Math.abs(z) - half) < S / 2) body.push(x, topY - thick, z);
      }
    const rTop = 0.62, rBot = 0.7, yTop = topY - thick, yBot = -0.42;
    for (let y = yBot; y <= yTop + 1e-6; y += S * 0.9) ring(body, rBot + (rTop - rBot) * ((y - yBot) / (yTop - yBot)), y);
    ring(body, 0.07, topY + 0.03, 0.03);
    const corner = new THREE.Vector3(half * 0.92, topY + 0.02, half * 0.92), start = new THREE.Vector3(0, topY + 0.04, 0);
    for (let t = 0; t <= 1; t += 0.03) { const p = start.clone().lerp(corner, t); tassel.push(p.x, p.y, p.z); }
    for (let y = corner.y; y >= corner.y - 0.75; y -= 0.035) tassel.push(corner.x, y, corner.z);
    for (let i = 0; i < 60; i++) { const a = Math.random() * Math.PI * 2, rr = Math.random() * 0.09; tassel.push(corner.x + Math.cos(a) * rr, corner.y - 0.75 - Math.random() * 0.3, corner.z + Math.sin(a) * rr); }
    const g = new THREE.Group(); g.add(points(body, 0.028, 'body'), points(tassel, 0.034, 'accent'));
    return { parts: [{ obj: g, spin: 1 }], tilt: 0.42, y: 0.12, startY: 0 };
  }

  function buildLaptop(): Built {
    const base: Arr = [], accent: Arr = [];
    const W = 1.25, D = 0.85, y0 = -0.45, t = 0.05;
    for (let x = -W; x <= W + 1e-6; x += S)
      for (let z = -D; z <= D + 1e-6; z += S) {
        base.push(x, y0, z);
        if (Math.abs(Math.abs(x) - W) < S / 2 || Math.abs(Math.abs(z) - D) < S / 2) base.push(x, y0 - t, z);
      }
    const tw = 0.42, tz0 = 0.28, tz1 = 0.72;
    for (let x = -tw; x <= tw; x += S * 0.7) base.push(x, y0 + 0.012, tz0, x, y0 + 0.012, tz1);
    for (let z = tz0; z <= tz1; z += S * 0.7) base.push(-tw, y0 + 0.012, z, tw, y0 + 0.012, z);
    for (let x = -1.0; x <= 1.0; x += 0.11) for (let z = -0.68; z <= 0.12; z += 0.11) base.push(x, y0 + 0.02, z);
    const H = 1.6, ang = (105 * Math.PI) / 180;
    const up = new THREE.Vector3(0, Math.sin(Math.PI - ang), -Math.cos(Math.PI - ang)).normalize();
    const hinge = new THREE.Vector3(0, y0, -D);
    const at = (x: number, h: number) => hinge.clone().add(new THREE.Vector3(x, 0, 0)).add(up.clone().multiplyScalar(h));
    for (let x = -W; x <= W + 1e-6; x += S)
      for (let h = 0; h <= H + 1e-6; h += S) {
        const frame = Math.abs(Math.abs(x) - W) < S / 2 || h < S / 2 || Math.abs(h - H) < S / 2;
        const inner = Math.abs(x) < W - 0.12 && h > 0.12 && h < H - 0.1;
        if (frame || !inner || (Math.round(x / S) + Math.round(h / S)) % 3 === 0) { const p = at(x, h); base.push(p.x, p.y, p.z); }
      }
    [[0.2, 1.3], [0.3, 0.9], [0.3, 1.6], [0.45, 0.7], [0.2, 1.1], [0.45, 1.4], [0.3, 0.5]].forEach(([ind, len], i) => {
      const h = H - 0.32 - i * 0.17;
      for (let x = -W + 0.2 + ind; x <= -W + 0.2 + ind + len; x += S * 0.8) { const p = at(x, h); accent.push(p.x, p.y, p.z); }
    });
    const g = new THREE.Group(); g.add(points(base, 0.028, 'body'), points(accent, 0.034, 'accent'));
    return { parts: [{ obj: g, spin: 1 }], tilt: 0.32, y: -0.2, startY: -0.5, noFog: true };
  }

  function buildSports(): Built {
    // Basketball: dotted sphere with seams in the accent colour
    const ball: Arr = [], seams: Arr = [], R = 0.72;
    sphere(ball, R, 650);
    for (let i = 0; i < 120; i++) {
      const a = (i / 120) * Math.PI * 2;
      seams.push(Math.cos(a) * R, Math.sin(a) * R, 0); // vertical seam
      seams.push(Math.cos(a) * R, 0, Math.sin(a) * R); // equator seam
    }
    // two curved side seams
    for (const s of [-1, 1])
      for (let i = 0; i < 120; i++) {
        const a = (i / 120) * Math.PI * 2;
        const v = new THREE.Vector3(s * 0.62, Math.sin(a) * 0.8, Math.cos(a) * 0.8 * (1 - 0.25 * Math.cos(2 * a))).normalize().multiplyScalar(R);
        seams.push(v.x, v.y, v.z);
      }
    const ballG = new THREE.Group(); ballG.add(points(ball, 0.026, 'body'), points(seams, 0.03, 'accent'));
    ballG.position.set(-0.85, 0.25, 0);

    // Dumbbell: handle with blue grip, two stacks of plates
    const db: Arr = [], grip: Arr = [];
    for (let x = -0.42; x <= 0.42; x += S * 0.7) ring(grip, 0.07, x, 0.035, 'x');
    for (const s of [-1, 1]) {
      for (let x = 0.42; x <= 0.5; x += 0.04) ring(db, 0.09, s * x, 0.04, 'x');
      for (const [x0, r] of [[0.52, 0.42], [0.62, 0.36]] as const)
        for (let x = x0; x <= x0 + 0.08; x += 0.04) {
          for (let rr = 0.12; rr <= r; rr += S) ring(db, rr, s * x, S, 'x');
        }
    }
    const dbG = new THREE.Group(); dbG.add(points(db, 0.026, 'body'), points(grip, 0.03, 'accent'));
    dbG.position.set(0.75, -0.55, 0.1); dbG.rotation.z = 0.35;

    return { parts: [{ obj: ballG, spin: 1 }, { obj: dbG, spin: -0.8 }], tilt: 0.2, y: 0, startY: 0 };
  }


  function tri(out: Arr, a: THREE.Vector3, b: THREE.Vector3, c: THREE.Vector3, step = S) {
    const ab = b.clone().sub(a), ac = c.clone().sub(a);
    const n = Math.ceil(Math.max(ab.length(), ac.length()) / step);
    for (let i = 0; i <= n; i++) for (let j = 0; j <= n - i; j++) {
      const p = a.clone().add(ab.clone().multiplyScalar(i / n)).add(ac.clone().multiplyScalar(j / n));
      out.push(p.x, p.y, p.z);
    }
  }
  function buildPlane(): Built {
    const body: Arr = [], accent: Arr = [];
    const V = (x: number, y: number, z: number) => new THREE.Vector3(x, y, z);
    const nose = V(1.25, 0.05, 0), tail = V(-1.05, 0.05, 0), keel = V(-0.95, -0.32, 0);
    tri(body, nose, tail, V(-1.1, 0.12, 0.85));   // right wing
    tri(body, nose, tail, V(-1.1, 0.12, -0.85));  // left wing
    tri(body, nose, tail, keel, S * 1.1);         // keel
    for (let t = 0; t <= 1; t += 0.02) { const p = nose.clone().lerp(tail, t); accent.push(p.x, p.y + 0.01, p.z); } // centre fold
    // dotted flight trail behind the plane
    for (let t = 0; t <= 1; t += 0.035) accent.push(-1.25 - t * 1.1, 0.05 - Math.sin(t * Math.PI) * 0.35 - t * 0.2, Math.sin(t * Math.PI * 1.5) * 0.25);
    const g = new THREE.Group(); g.add(points(body, 0.028, 'body'), points(accent, 0.034, 'accent'));
    g.rotation.z = 0.12;
    return { parts: [{ obj: g, spin: 1 }], tilt: 0.35, y: 0.05, startY: -0.6, noFog: true };
  }

  // ---------- render each canvas ----------
  document.querySelectorAll<HTMLCanvasElement>('canvas.dotmodel').forEach((canvas) => {
    const model = canvas.dataset.model;
    const extra = canvas.dataset.extra ? JSON.parse(canvas.dataset.extra) : null;
    const start = mats.length;
    const built = model === 'globe' ? buildGlobe(extra) : model === 'laptop' ? buildLaptop() : model === 'sports' ? buildSports() : model === 'plane' ? buildPlane() : buildCap();
    const myMats = mats.slice(start);

    const outer = new THREE.Group();
    built.parts.forEach((p) => outer.add(p.obj));
    outer.rotation.x = built.tilt; outer.position.y = built.y;
    if (built.parts.length === 1) built.parts[0].obj.rotation.y = built.startY;

    const scene = new THREE.Scene(); scene.add(outer);
    const camera = new THREE.PerspectiveCamera(35, 1, 0.1, 50); camera.position.set(0, 0, 6);
    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));

    const theme = () => {
      const dark = isDark();
      scene.fog = built.noFog ? null : new THREE.Fog(new THREE.Color(getComputedStyle(document.body).backgroundColor), 5.0, 8.2);
      myMats.forEach(({ m, kind, color }) => {
        if (kind === 'body') { m.color = new THREE.Color(dark ? '#cfcfcf' : '#3a3a3a'); m.opacity = dark ? 0.85 : 0.75; }
        if (kind === 'faint') { m.color = new THREE.Color(dark ? '#cfcfcf' : '#3a3a3a'); m.opacity = dark ? 0.18 : 0.14; }
        if (kind === 'accent') { m.color = new THREE.Color(dark ? '#60a5fa' : '#2563eb'); m.opacity = 0.95; }
        if (kind === 'color') { m.color = new THREE.Color(color); m.opacity = 1; }
        if (kind === 'water') { m.color = new THREE.Color(dark ? '#3b82f6' : '#93c5fd'); m.opacity = dark ? 0.45 : 0.55; }
        if (kind === 'faintAccent') { m.color = new THREE.Color(dark ? '#60a5fa' : '#2563eb'); m.opacity = 0.45; }
      });
    };
    theme();
    new MutationObserver(theme).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', theme);

    const resize = () => { const w = canvas.clientWidth; renderer.setSize(w, w, false); };
    resize(); window.addEventListener('resize', resize);

    let dragging = false, lastX = 0, lastY = 0;
    let active = built.parts; // which objects the current drag moves
    const pick = (e: PointerEvent) => {
      if (built.parts.length === 1) return built.parts;
      const r = canvas.getBoundingClientRect();
      const mx = ((e.clientX - r.left) / r.width) * 2 - 1, my = -(((e.clientY - r.top) / r.height) * 2 - 1);
      let best = built.parts[0], bd = Infinity;
      built.parts.forEach((p) => {
        const v = new THREE.Vector3(); p.obj.getWorldPosition(v); v.project(camera);
        const d = (v.x - mx) ** 2 + (v.y - my) ** 2;
        if (d < bd) { bd = d; best = p; }
      });
      return [best];
    };
    canvas.addEventListener('pointerdown', (e) => { dragging = true; active = pick(e); lastX = e.clientX; lastY = e.clientY; canvas.setPointerCapture(e.pointerId); canvas.style.cursor = 'grabbing'; });
    canvas.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      active.forEach((p) => {
        p.obj.rotation.y += (e.clientX - lastX) * 0.008;
        if (built.parts.length > 1) p.obj.rotation.x = Math.max(-1.2, Math.min(1.2, p.obj.rotation.x + (e.clientY - lastY) * 0.006));
      });
      if (built.parts.length === 1) outer.rotation.x = Math.max(-0.4, Math.min(1.1, outer.rotation.x + (e.clientY - lastY) * 0.006));
      lastX = e.clientX; lastY = e.clientY;
    });
    const end = () => { dragging = false; canvas.style.cursor = 'grab'; };
    canvas.addEventListener('pointerup', end); canvas.addEventListener('pointercancel', end);

    const frame = (t = 0) => {
      if (built.update && !reduce) built.update(t);
      if (!reduce) built.parts.forEach((p) => { if (!(dragging && active.includes(p))) p.obj.rotation.y += 0.004 * p.spin; });
      renderer.render(scene, camera);
      requestAnimationFrame(frame);
    };
    frame();
    canvas.style.opacity = '1';
  });
</script>

<style>
  .dm-wrap { width: 100%; }
  canvas.dotmodel { width: 100%; max-width: 440px; aspect-ratio: 1; display: block; margin: 0 auto; cursor: grab; touch-action: pan-y; opacity: 0; transition: opacity .8s; }
</style>
