---
interface Props { model: 'cap' | 'laptop'; label: string }
const { model, label } = Astro.props;
---
<div class="cap-wrap">
  <canvas class="dotmodel" data-model={model} aria-label={label}></canvas>
</div>

<script>
  import * as THREE from 'three';
  document.querySelectorAll<HTMLCanvasElement>('canvas.dotmodel').forEach((canvas) => {


  
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isDark = () => {
    const t = document.documentElement.dataset.theme;
    return t ? t === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
  };

  const body: number[] = [];
  const tassel: number[] = [];
  const S = 0.055; // dot spacing
  if (canvas.dataset.model === 'laptop') buildLaptop(body, tassel, S); else {

  // Board: flat square, slightly thick
  const half = 1.15, topY = 0.32, thick = 0.06;
  for (let x = -half; x <= half + 1e-6; x += S)
    for (let z = -half; z <= half + 1e-6; z += S) {
      body.push(x, topY, z);
      const edge = Math.abs(Math.abs(x) - half) < S / 2 || Math.abs(Math.abs(z) - half) < S / 2;
      if (edge) body.push(x, topY - thick, z);
    }
  // Skull cap: slightly tapered band under the board
  const rTop = 0.62, rBot = 0.7, yTop = topY - thick, yBot = -0.42;
  for (let y = yBot; y <= yTop + 1e-6; y += S * 0.9) {
    const t = (y - yBot) / (yTop - yBot);
    const r = rBot + (rTop - rBot) * t;
    const n = Math.round((2 * Math.PI * r) / S);
    for (let i = 0; i < n; i++) {
      const a = (i / n) * Math.PI * 2;
      body.push(Math.cos(a) * r, y, Math.sin(a) * r);
    }
  }
  // Button on top
  for (let i = 0; i < 18; i++) {
    const a = (i / 18) * Math.PI * 2;
    body.push(Math.cos(a) * 0.07, topY + 0.03, Math.sin(a) * 0.07);
  }
  // Tassel: cord from button to a corner, then hanging down, ending in a fringe
  const corner = new THREE.Vector3(half * 0.92, topY + 0.02, half * 0.92);
  const start = new THREE.Vector3(0, topY + 0.04, 0);
  for (let t = 0; t <= 1; t += 0.03) {
    const p = start.clone().lerp(corner, t);
    tassel.push(p.x, p.y, p.z);
  }
  for (let y = corner.y; y >= corner.y - 0.75; y -= 0.035) tassel.push(corner.x, y, corner.z);
  for (let i = 0; i < 60; i++) {
    const a = Math.random() * Math.PI * 2, rr = Math.random() * 0.09;
    const y = corner.y - 0.75 - Math.random() * 0.3;
    tassel.push(corner.x + Math.cos(a) * rr, y, corner.z + Math.sin(a) * rr);
  }
  }


  function buildLaptop(base: number[], accent: number[], S: number) {
    const W = 1.25, D = 0.85, y0 = -0.45, t = 0.05;
    // base slab: top surface + bottom edge outline
    for (let x = -W; x <= W + 1e-6; x += S)
      for (let z = -D; z <= D + 1e-6; z += S) {
        base.push(x, y0, z);
        const edge = Math.abs(Math.abs(x) - W) < S / 2 || Math.abs(Math.abs(z) - D) < S / 2;
        if (edge) base.push(x, y0 - t, z);
      }
    // trackpad outline (front centre)
    const tw = 0.42, tz0 = 0.28, tz1 = 0.72;
    for (let x = -tw; x <= tw; x += S * 0.7) { base.push(x, y0 + 0.012, tz0, x, y0 + 0.012, tz1); }
    for (let z = tz0; z <= tz1; z += S * 0.7) { base.push(-tw, y0 + 0.012, z, tw, y0 + 0.012, z); }
    // keyboard keys (small raised dots)
    for (let x = -1.0; x <= 1.0; x += 0.11)
      for (let z = -0.68; z <= 0.12; z += 0.11) base.push(x, y0 + 0.02, z);
    // screen: hinged at the back edge, opened ~105 degrees
    const H = 1.6, ang = (105 * Math.PI) / 180;
    const up = new THREE.Vector3(0, Math.sin(Math.PI - ang), -Math.cos(Math.PI - ang)).normalize();
    const hinge = new THREE.Vector3(0, y0, -D);
    const at = (x: number, h: number) => hinge.clone().add(new THREE.Vector3(x, 0, 0)).add(up.clone().multiplyScalar(h));
    for (let x = -W; x <= W + 1e-6; x += S)
      for (let h = 0; h <= H + 1e-6; h += S) {
        const frame = Math.abs(Math.abs(x) - W) < S / 2 || h < S / 2 || Math.abs(h - H) < S / 2;
        const inner = Math.abs(x) < W - 0.12 && h > 0.12 && h < H - 0.1;
        if (frame || (!inner) || ((Math.round(x / S) + Math.round(h / S)) % 3 === 0)) {
          const p = at(x, h); base.push(p.x, p.y, p.z);
        }
      }
    // "code" lines on the screen in the accent colour
    const lines = [[0.2, 1.3], [0.3, 0.9], [0.3, 1.6], [0.45, 0.7], [0.2, 1.1], [0.45, 1.4], [0.3, 0.5]];
    lines.forEach(([indent, len], i) => {
      const h = H - 0.32 - i * 0.17;
      for (let x = -W + 0.2 + indent; x <= -W + 0.2 + indent + len; x += S * 0.8) {
        const p = at(x, h).add(new THREE.Vector3(0, 0, 0)); accent.push(p.x, p.y, p.z);
      }
    });
  }

  const makePoints = (arr: number[], size: number) => {
    const g = new THREE.BufferGeometry();
    g.setAttribute('position', new THREE.Float32BufferAttribute(arr, 3));
    const m = new THREE.PointsMaterial({ size, sizeAttenuation: true, transparent: true, depthWrite: false });
    return new THREE.Points(g, m);
  };
  const capPts = makePoints(body, 0.028);
  const tasselPts = makePoints(tassel, 0.034);

  const group = new THREE.Group();
  group.add(capPts, tasselPts);
  const isLaptop = canvas.dataset.model === 'laptop';
  group.rotation.x = isLaptop ? 0.32 : 0.42;
  group.position.y = isLaptop ? -0.2 : 0.12;
  if (isLaptop) group.rotation.y = -0.5;

  const scene = new THREE.Scene();
  scene.add(group);
  const camera = new THREE.PerspectiveCamera(35, 1, 0.1, 50);
  camera.position.set(0, 0, 6);

  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));

  function applyTheme() {
    const dark = isDark();
    const bg = getComputedStyle(document.body).backgroundColor;
    scene.fog = new THREE.Fog(new THREE.Color(bg), 5.0, 8.2); // dots further back fade, like depth on the globe
    (capPts.material as THREE.PointsMaterial).color = new THREE.Color(dark ? '#cfcfcf' : '#3a3a3a');
    (capPts.material as THREE.PointsMaterial).opacity = dark ? 0.85 : 0.75;
    (tasselPts.material as THREE.PointsMaterial).color = new THREE.Color(dark ? '#60a5fa' : '#2563eb');
    (tasselPts.material as THREE.PointsMaterial).opacity = 0.95;
  }
  applyTheme();
  new MutationObserver(applyTheme).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', applyTheme);

  function resize() {
    const w = canvas.clientWidth;
    renderer.setSize(w, w, false);
    camera.aspect = 1;
    camera.updateProjectionMatrix();
  }
  resize();
  window.addEventListener('resize', resize);

  // ---- motion: slow spin, drag to rotate ----
  let dragging = false, lastX = 0, lastY = 0;
  canvas.addEventListener('pointerdown', (e) => { dragging = true; lastX = e.clientX; lastY = e.clientY; canvas.setPointerCapture(e.pointerId); canvas.style.cursor = 'grabbing'; });
  canvas.addEventListener('pointermove', (e) => {
    if (!dragging) return;
    group.rotation.y += (e.clientX - lastX) * 0.008;
    group.rotation.x = Math.max(-0.2, Math.min(1.1, group.rotation.x + (e.clientY - lastY) * 0.006));
    lastX = e.clientX; lastY = e.clientY;
  });
  const end = () => { dragging = false; canvas.style.cursor = 'grab'; };
  canvas.addEventListener('pointerup', end);
  canvas.addEventListener('pointercancel', end);

  function frame() {
    if (!dragging && !reduce) group.rotation.y += 0.004;
    renderer.render(scene, camera);
    requestAnimationFrame(frame);
  }
  frame();
  canvas.style.opacity = '1';

  });
</script>

<style>
  .cap-wrap { width: 100%; }
  canvas.dotmodel { width: 100%; max-width: 440px; aspect-ratio: 1; display: block; margin: 0 auto; cursor: grab; touch-action: pan-y; opacity: 0; transition: opacity .8s; }
</style>
