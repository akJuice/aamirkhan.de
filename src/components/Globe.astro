---
import DotModel from './DotModel.astro';
import { geoContains } from 'd3-geo';
import { feature } from 'topojson-client';
import world from 'world-atlas/land-110m.json';
import countries from 'world-atlas/countries-110m.json';

const places = [
  { name: 'India', note: 'Born in Bangalore', loc: [20.6, 78.9] as [number, number], color: '#f97316' },
  { name: 'Turkey', note: 'Childhood, 2005–2016', loc: [39.0, 35.2] as [number, number], color: '#e11d48' },
  { name: 'Germany', note: 'Since 2016', loc: [51.1, 10.4] as [number, number], color: '#2563eb' },
];

// Land dots: evenly spaced points on a sphere, kept only where there is land (computed at build time)
const land = feature(world as any, (world as any).objects.land) as any;
const N = 9000, pts: number[] = [], hi: number[] = [];
const all = feature(countries as any, (countries as any).objects.countries) as any;
const lived = all.features.filter((f: any) => ['356', '792', '276'].includes(String(f.id)));
const golden = Math.PI * (3 - Math.sqrt(5));
for (let i = 0; i < N; i++) {
  const y = 1 - (i / (N - 1)) * 2, a = golden * i;
  const lat = (Math.asin(y) * 180) / Math.PI;
  const lng = ((((a * 180) / Math.PI) % 360) + 540) % 360 - 180;
  if (!geoContains(land, [lng, lat])) continue;
  const target = lived.some((f: any) => geoContains(f, [lng, lat])) ? hi : pts;
  target.push(Math.round(lat * 10) / 10, Math.round(lng * 10) / 10);
}
---
<figure class="globe-wrap">
  <DotModel model="globe" label="3D globe marking where Aamir has lived: India, Turkey and Germany" data={{ land: pts, hi, places }} />
  </figure>

<style>
  .globe-wrap { margin: 0; }
</style>
