---
// Clean, thin arrow that matches the Geist type: slides on hover, takes the link colour
interface Props { dir?: 'right' | 'left' }
const { dir = 'right' } = Astro.props;
---
<svg class:list={['link-arrow', dir === 'left' && 'left']} width="0.9em" height="0.9em" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {dir === 'left' ? <path d="M13 8H3M7.5 3.5 3 8l4.5 4.5" /> : <path d="M3 8h10M8.5 3.5 13 8l-4.5 4.5" />}
</svg>

<style>
  .link-arrow { display: inline-block; vertical-align: -0.1em; margin-left: .35em; transition: transform .25s cubic-bezier(.2,.7,.2,1); }
  .link-arrow.left { margin: 0 .35em 0 0; }
  :global(a:hover) > .link-arrow:not(.left), :global(a:focus-visible) > .link-arrow:not(.left) { transform: translateX(4px); }
  :global(a:hover) > .link-arrow.left, :global(a:focus-visible) > .link-arrow.left { transform: translateX(-4px); }
</style>
